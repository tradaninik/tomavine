generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Scope {
  RADIUS
  CITY
  STATE
  INDIA
}

enum DeliveryMode {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String           @id @default(cuid())
  phone         String           @unique
  name          String?
  role          Role             @default(CUSTOMER)
  lang          String           @default("en")
  city          String?
  pincode       String?
  permissions   Json?
  createdAt     DateTime         @default(now())
  orders        Order[]
  reviews       Review[]
  journals      PlantJournal[]
  subscriptions Subscription[]
  waBinding     WhatsappBinding?
  auditLogs     AuditLog[]
  nursery       Nursery?

  @@index([phone])
}

model Nursery {
  verified Boolean @default(false)
  id             String             @id @default(cuid())
  ownerId        String             @unique
  owner          User               @relation(fields: [ownerId], references: [id])
  name           String
  slug           String             @unique
  phone          String
  gstin          String
  city           String
  area           String
  pincode        String
  scope          Scope              @default(RADIUS)
  scopeKm        Int?
  bulkOk         Boolean            @default(true)
  retailOk       Boolean            @default(true)
  status         VerificationStatus @default(PENDING)
  physVerifiedAt DateTime?
  growArea       String?
  image          String?
  districtCode   String?
  lat            Float?
  lng            Float?
  categories     Json?
  // Franchise controls (mission F): per-nursery module/payment switches
  // the super admin sets, mirroring an opt-in sheet. null = every module
  // on (the default for pre-existing nurseries); an object disables a
  // module only where a key is explicitly false. Keys live in
  // src/lib/nursery-features.ts — unknown keys are ignored, missing keys
  // read as enabled, so new toggles start ON for everyone.
  features       Json?
  ratingAvg      Float              @default(0)
  products       Product[]
  services       ServiceListing[]
  orders         Order[]
  quotes         Quote[]
  serviceAreas   NurseryServiceArea[]

  @@index([city])
  @@index([status])
  @@index([districtCode])
}

// Two-level browse tree (phase 2a). Tops have parentId null; subs point
// at their top. slug is globally unique (future /shop/c/[slug] URLs).
// names is the 6-language display dictionary {en,hi,te,kn,ta,mr}.
// gstRate: whole percent (5 = 5%). null = inherit from parent; at top
// level null = keep the legacy code-based rate until set.
// legacyKey (tops only, unique): the Product.category string this top
// replaces during the transition; dropped when legacy fields retire.
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children  Category[] @relation("CategoryTree")
  names     Json?
  emoji     String?
  gstRate   Int?
  legacyKey String?    @unique
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  products  Product[]

  @@index([parentId])
  @@index([active, sortOrder])
}

model Product {
  id           String           @id @default(cuid())
  nurseryId    String
  nursery      Nursery          @relation(fields: [nurseryId], references: [id])
  category     String
  categoryId   String?
  categoryNode Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nameEn       String
  names        Json?
  botanical    String?
  badges       Json?
  care         Json?
  agri         Json?
  provenance   Json?
  priceMin     Int
  mrp          Int
  stock        Int              @default(0)
  hidden       Boolean          @default(false)
  subCategory  String?
  image        String?
  createdAt    DateTime         @default(now())
  variants     ProductVariant[]
  rescue       RescueListing?
  orderItems   OrderItem[]
  reviews      Review[]

  @@index([nurseryId])
  @@index([category])
  @@index([categoryId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  price     Int
  sku       String  @unique
}

model RescueListing {
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  pct       Int
  expiresAt DateTime
}

model Order {
  id          String       @id @default(cuid())
  code        String       @unique
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  nurseryId   String
  nursery     Nursery      @relation(fields: [nurseryId], references: [id])
  status      OrderStatus  @default(PENDING)
  mode        DeliveryMode @default(DELIVERY)
  subtotal    Int
  deliveryFee Int
  tax         Int
  discount    Int          @default(0)
  total       Int
  address     Json
  deliveryOtp String?
  meta        Json?
  createdAt   DateTime     @default(now())
  items       OrderItem[]
  events      OrderEvent[]
  payment     Payment?
  review      Review?

  @@index([userId])
  @@index([nurseryId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  qty       Int
  unitPrice Int
  nameSnap  String
  vlabel    String?
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorRole Role
  createdAt DateTime    @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  provider       String        @default("razorpay")
  rzpOrderId     String?       @unique
  rzpPaymentId   String?
  method         String?
  amount         Int
  status         PaymentStatus @default(CREATED)
  capturedAt     DateTime?
  idempotencyKey String?       @unique
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id])
  stars     Int
  text      String
  reply     String?
  createdAt DateTime @default(now())
}

model ServiceListing {
  id            String         @id @default(cuid())
  nurseryId     String
  nursery       Nursery        @relation(fields: [nurseryId], references: [id])
  type          String
  name          String
  price         Int
  includes      Json
  subscriptions Subscription[]
}

model Subscription {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  serviceId   String
  service     ServiceListing @relation(fields: [serviceId], references: [id])
  status      String         @default("active")
  nextVisitAt DateTime
}

model PlantJournal {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  productId String
  orderId   String
  entries   Json
}

// Mission S2: bulk quote requests + pre-orders. New columns are
// nullable / defaulted so pre-S2 rows keep working. type separates a
// classic BULK quote (in-stock, huge qty) from a PREORDER request
// (out-of-stock line, nursery confirms by call/WhatsApp, no online
// payment ever touches the gateway for these).
model BulkLead {
  id        String   @id @default(cuid())
  productId String?
  qty       Int
  city      String
  company   String
  phone     String?
  pincode   String?
  state     String?
  neededBy  DateTime?
  type      String   @default("BULK")
  notes     String?
  status    String   @default("new")
  parts     Json?
  items     Json?
  quotes    Quote[]
}

model Quote {
  id        String   @id @default(cuid())
  leadId    String
  lead      BulkLead @relation(fields: [leadId], references: [id])
  nurseryId String
  nursery   Nursery  @relation(fields: [nurseryId], references: [id])
  amount    Int
  status    String   @default("sent")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  hash      String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model WhatsappBinding {
  userId           String  @id
  user             User    @relation(fields: [userId], references: [id])
  waId             String  @unique
  lastAlertOrderId String?
}

model WhatsappLog {
  id        String   @id @default(cuid())
  waId      String
  template  String?
  body      String?
  direction String
  status    String?
  createdAt DateTime @default(now())

  @@index([waId, createdAt])
}

model AuditLog {
  id      String   @id @default(cuid())
  actorId String
  actor   User     @relation(fields: [actorId], references: [id])
  action  String
  entity  String
  meta    Json?
  at      DateTime @default(now())

  @@index([actorId])
}

model TaxonomyTerm {
  id        String   @id @default(cuid())
  kind      String
  label     String
  names     Json?
  groupName String?
  note      String?
  meta      Json?
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([kind, label])
  @@index([kind, active, sort])
}

// Serviceable-pincode list (mission X2). The owner curates the
// pincodes Tomavine actively serves; every active row appears as a
// dropdown suggestion on the storefront pincode inputs (nurseries
// search, checkout address, sell application). pincode is the
// identity — unique, and editable only through the admin console.
// Nothing on the storefront is BLOCKED by absence: an unlisted
// pincode still works, it just gets no dropdown suggestion.
model ServiceLocation {
  id           String   @id @default(cuid())
  pincode      String   @unique
  city         String
  state        String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  nurseryAreas NurseryServiceArea[]

  @@index([active])
}

// Which nursery serves which pincode (mission F). Rows are created by
// the nursery admin from the seller console ("Locations") or by the
// super admin assigning service areas on the nursery form. The
// storefront pincode search turns a matching row into a "Delivers to
// your pincode" verdict for that nursery. Unlinking = deleting the row;
// the master ServiceLocation row always stays.
model NurseryServiceArea {
  id         String          @id @default(cuid())
  nurseryId  String
  nursery    Nursery         @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  locationId String
  location   ServiceLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([nurseryId, locationId])
  @@index([locationId])
}

// Mission S3: admin-editable site configuration (bulk tiers, max qty,
// pre-order switch, WhatsApp number). One row, key "bulk"; read per
// request by src/lib/settings.ts with code defaults as fallback.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}